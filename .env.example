# No credentials are supplied. Keep .env private and choose a unique queue password.
SERVICE_UID=568
SERVICE_GID=568
QUEUE_USER=operator
QUEUE_PASSWORD=
BIND_ADDRESS=127.0.0.1
QUEUE_PORT=8080

# ARM Neu backend API origin, not necessarily its separate UI address.
ARM_URL=
# Only for deployments using a bearer-authenticating reverse proxy; ARM_API_KEY is unrelated.
ARM_BEARER_TOKEN=
ARM_EXPECTED_VERSION=19.1.0
# Fill only after verifying the actual deployed source; see docs/compatibility.md.
ARM_VERIFIED_SOURCE_SHA=
ARM_DRIVE=/dev/sr0
ARM_MEDIA_PREFIX=/home/arm/media
ARM_MEDIA_HOST=

STATE_HOST=/mnt/POOL/apps/arm-season-queue/state
HANDOVER_HOST=/mnt/POOL/apps/arm-season-queue/handover
LIBRARY_HOST=/mnt/POOL/media/library

# Logitech MX Brio: discover the capture node, preferably /dev/v4l/by-id/...-video-index0.
CAMERA_HOST_DEVICE=
CAMERA_GID=
CAMERA_WIDTH=3840
CAMERA_HEIGHT=2160
CAMERA_FPS=15
CAMERA_ROTATION=0
CAMERA_ROI=0.15,0.1,0.85,0.9
CAMERA_SHARPNESS=100
# Default makes no vision requests. Agreement mode requires local Ollama and the exact two configured tags.
RECOGNITION_BACKEND=tesseract
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
VISION_TIMEOUT_SECONDS=300
# Short Qwen review defaults; keep any test overrides private and bounded.
VISION_SHORT_NUM_PREDICT=768
VISION_SHORT_TIMEOUT_SECONDS=240
OCR_LANG=deu+eng
CAPTURE_TTL_SECONDS=180
EVIDENCE_RETENTION_DAYS=30
BATCH_SWITCH_POLICY=review

# Informational deployment record. No undocumented FileFlows API is called.
# Integration uses the mounted handover contract, so no FileFlows URL is needed at runtime.
FILEFLOWS_URL=
FILEFLOWS_VERSION=
